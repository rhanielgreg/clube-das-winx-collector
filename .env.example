# Credenciais privadas do Railway (nunca expor no frontend)
SFTP_HOST=seu-host-sftp
SFTP_PORT=2022
SFTP_USER=seu-usuario-sftp
SFTP_PASSWORD=troque-a-senha-exposta-antes-de-usar
SFTP_DB_PATH=/caminho/real/para/players.db
# Linha known_hosts no formato [host]:2022 ssh-ed25519 AAAA...
# Obtenha a chave por canal confiavel e CONFIRA a fingerprint com a hospedagem.
SFTP_KNOWN_HOSTS=[seu-host-sftp]:2022 ssh-ed25519 CHAVE_PUBLICA_VERIFICADA
PLAYER_HASH_SALT=string-aleatoria-longa-e-secreta
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=chave-privada-do-supabase
COLLECTOR_LOCK_TTL_SECONDS=240
DRY_RUN=true

# Contrato futuro; vazio mantém legado. Habilitar life-v1 só após migrações e fonte validada.
LIFE_PIPELINE_VERSION=
# Chave privada do emissor autorizado (mínimo 32 caracteres); nunca preencher no Git.
LIFE_ATTESTATION_KEY=
# Alternativa existente: ttf-mp-v1, após validar fontes/namespace e migrações.
# UUID operacional estável do mundo/origem, confirmado pelo responsável; não regenerar por coleta.
LIFE_SOURCE_NAMESPACE_UUID=
# Diretório absoluto da variante MP STABLE/42.19 com fontes conferidas por hash.
TTF_SOURCE_ROOT=
